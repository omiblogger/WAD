# COPY this file to .env; put keys ONLY there. Never commit .env
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_OWN_AUTHORIZED_KEY
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_MODEL=YOUR_CHAT_DEPLOYMENT_NAME
AZURE_OPENAI_EMBEDDING_MODEL=YOUR_EMBEDDING_DEPLOYMENT_NAME
# Only for /chat local practice; supply X-App-Token header
APP_ACCESS_TOKEN=SET_A_RANDOM_LOCAL_DEMO_TOKEN
# Optional Azure AI Search existing index (Day 3)
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_KEY=YOUR_SEARCH_KEY
AZURE_SEARCH_INDEX=YOUR_INDEX_NAME
